# Auto-detect text files and normalise line endings to LF
* text=auto eol=lf

# Java source
*.java text eol=lf

# Config / markup
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf

# Binaries — never touch line endings
*.class binary
*.jar   binary
*.zip   binary
*.png   binary
*.jpg   binary
